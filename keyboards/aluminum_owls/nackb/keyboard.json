{
    "manufacturer": "Andrew Chao",
    "keyboard_name": "NACKB",
    "maintainer": "polarbearhoodie",
    "bootloader": "stm32duino",
    "diode_direction": "ROW2COL",

    "features": {
        "oneshot": true,
        "nkro": true,
        "extrakey": true
    },

    "capsword": {
        "enabled": true,
        "double_tap_shift_turns_on": true
    },

    "split": {
        "enabled": true,
        "handedness": {
            "pin": "B9",
        },

        "matrix_pins": {
            "right": {
                "cols": ["B12", "B13", "B14", "B15", "B3", "B4", "B5"],
                "rows": ["B11", "B10", "B1", "B0"]
            }
        },

        "serial": {
            "driver": "usart",
            "pin": "A2"
        },

        "transport":{
            "protocol": "serial",
            "sync": {
                "layer_state": true,
                "modifiers": true
            },
            "watchdog": true
        },
    },

    "matrix_pins": {
        "cols": ["B12", "B13", "B14", "B15", "B3", "B4","B5"],
        "rows": ["B11", "B10", "B1", "B0"]
    },

    "processor": "STM32F103",
    "url": "",
